root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{js,jsx,mjs,cjs,ts,tsx,mts,cts,css,scss,sass,less,styl,json,md,yml,yaml}]
indent_style = space
indent_size = 2
max_line_length = 100

[*.java]
indent_style = space
indent_size = 4
max_line_length = 120

[*.{xml,properties}]
indent_style = space
indent_size = 4

[*.{bat,cmd}]
end_of_line = crlf
